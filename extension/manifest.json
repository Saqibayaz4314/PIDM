{
  "manifest_version": 3,
  "name": "PIDM Browser Connect",
  "version": "0.6.1",
  "key": "",
  "description": "Send files and select video qualities with PIDM Download Manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:17341/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Download with PIDM",
    "default_icon": {
      "16": "icons/pidm-16.png",
      "32": "icons/pidm-32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/pidm-16.png",
    "32": "icons/pidm-32.png",
    "48": "icons/pidm-48.png",
    "128": "icons/pidm-128.png"
  }
}
